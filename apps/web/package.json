{
  "name": "@treemaker/web",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "build:treemaker-wasm": "wasm-pack build ../../crates/treemaker-wasm --target web --out-dir ../../apps/web/src/generated/treemaker-wasm",
    "build:oristudio-cp-wasm": "wasm-pack build ../../crates/oristudio-cp-wasm --target web --out-dir ../../apps/web/src/generated/oristudio-cp-wasm",
    "build:oristudio-bp-wasm": "wasm-pack build ../../crates/oristudio-bp-wasm --target web --out-dir ../../apps/web/src/generated/oristudio-bp-wasm",
    "build:oristudio-cp-detect-wasm": "wasm-pack build ../../crates/oristudio-cp-detect-wasm --target web --out-dir ../../apps/web/src/generated/oristudio-cp-detect-wasm && npm run gen:cp-detect-defaults",
    "gen:cp-detect-defaults": "cargo run -q --manifest-path ../../Cargo.toml -p oristudio-cp-detect --bin emit_cp_detect_defaults_ts > src/generated/cpDetectDefaults.generated.ts",
    "build:wasm": "npm run build:treemaker-wasm && npm run build:oristudio-cp-wasm && npm run build:oristudio-bp-wasm && npm run build:oristudio-cp-detect-wasm",
    "build:simulator": "npm --workspace @treemaker/origami-simulator run build",
    "predev": "npm run build:simulator && npm run build:wasm",
    "prebuild": "npm run build:simulator && npm run build:wasm",
    "pretypecheck": "npm run build:simulator && npm run build:wasm",
    "pretest": "npm run build:simulator && npm run build:wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "i18n:stamp": "node scripts/i18n/stamp.mjs",
    "i18n:check": "node scripts/i18n/check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@treemaker/origami-simulator": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "comlink": "^4.4.2",
    "dockview": "^4.13.1",
    "earcut": "^3.2.3",
    "i18next": "^25.10.10",
    "i18next-http-backend": "^3.0.6",
    "lucide-react": "^0.563.0",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "sonner": "^2.0.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.4.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "i18next-parser": "^9.4.0",
    "jsdom": "^29.1.0",
    "playwright": "^1.60.0",
    "regl": "^2.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
