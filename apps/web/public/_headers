# Cross-origin isolation for the wasm engine (SharedArrayBuffer).
#
# These apply to static assets only — Cloudflare Pages does not apply `_headers` to Pages
# Function responses, so `functions/s/[[shareId]].ts` sets both itself. Changing them here
# means changing them there too.
#
# DO NOT add a `404.html` to this directory. Pages serves it instead of `index.html` for
# unmatched paths, which is the SPA fallback every share link depends on: `/s/<id>` calls
# `context.next()` expecting `index.html`, and would render the error page instead. The
# post-deploy smoke test (scripts/share-smoke.mjs) asserts against exactly this.
#
# The `/*` rule also covers `/sw.js`, which is what makes the service worker legal to
# register on a `require-corp` page at all. Narrowing it to `/assets/*` would break the
# worker as well as the page. `scripts/webkit-pwa-check.mjs` reads this file rather than
# hardcoding the two headers, so removing them fails that check instead of shipping.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Belt and braces on the one file whose staleness has no recovery path: a browser that
# holds an old `sw.js` keeps serving from it, and the fix would be asking people to clear
# site data — which for an installed app means deleting it. Registration's default
# `updateViaCache: 'imports'` already bypasses the HTTP cache for the top-level worker
# script, and Pages already serves unhashed files `max-age=0`; this only means neither has
# to stay true for the recovery in `src/pwa/swKill.ts` to reach anybody.
/sw.js
  Cache-Control: no-cache

/sw-kill.js
  Cache-Control: no-cache

# Everything under /assets/ is content-hashed by the build, so a changed file is a new URL
# and a cached one can never go stale. Served with a 4-hour max-age without this.
#
# But only for browsers. These rules apply by path, so Pages' answer for a file it does not
# have (index.html at 200; there is no 404.html, see above) gets the same year. Cloudflare's
# edge in front of oristudio.dev honoured that on 2026-11-19: a request that reached the new
# entry a second before the deploy did cached index.html as the entry, and every visitor
# that edge served got a blank page until the zone was purged. Unstamped names (workers,
# CSS, fonts) recur across deploys, so a name asked for while absent (after a rollback, or
# before it was ever deployed) would come back poisoned the same way. So the edge stores
# none of it: `Cloudflare-CDN-Cache-Control` drives Cloudflare's own caching and is not
# passed on, while browsers still get the year above. Pages serves these from its own cache,
# as it does on oristudio.pages.dev, which has no zone cache at all. The deploy's ordering
# (`scripts/assets-first-deploy.mjs`) is the other half, for browsers that race a deploy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: no-store

# The Diagram's CJK fonts. The desktop app ships only the common files and reads a full
# one from here when a text needs it (src/diagram/fonts/browserFontSource.ts), so it must
# be readable across origins. Every download is checked against the manifest's sha256.
/fonts/diagram/*
  Access-Control-Allow-Origin: *

# The empty Diagram's example crane (src/diagram/example/diagramExample.ts). Pages types an
# `.osf` as Yamaha's Open Score Format, which Cloudflare sends uncompressed: 3.4 MB. Named
# for what it is, JSON, it goes out compressed.
/examples/*
  Content-Type: application/json
