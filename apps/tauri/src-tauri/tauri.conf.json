{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ori Studio",
  "version": "0.2.1",
  "identifier": "com.zacharymarion.oristudio",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../web"
    },
    "beforeBuildCommand": {
      "script": "node scripts/build-frontend.mjs",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ori Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob: ipc: http://ipc.localhost https://us.i.posthog.com https://us-assets.i.posthog.com https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://*.ingest.sentry.io; object-src 'none'; frame-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob: ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:* https://us.i.posthog.com https://us-assets.i.posthog.com https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://*.ingest.sentry.io; object-src 'none'; frame-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "fileAssociations": [
      {
        "ext": [
          "osf"
        ],
        "name": "Ori Studio Project",
        "description": "Ori Studio Project",
        "mimeType": "application/vnd.oristudio.project+json",
        "role": "Editor",
        "rank": "Owner",
        "contentTypes": [
          "com.zacharymarion.oristudio.project"
        ],
        "exportedType": {
          "identifier": "com.zacharymarion.oristudio.project",
          "conformsTo": [
            "public.json"
          ]
        }
      }
    ],
    "resources": {
      "icons/osf.icns": "osf.icns",
      "icons/osf.ico": "osf.ico"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop",
        "files": {
          "/usr/share/mime/packages/oristudio.xml": "linux/oristudio-mime.xml",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-vnd.oristudio.project+json.png": "linux/mimetypes/32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-vnd.oristudio.project+json.png": "linux/mimetypes/48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-vnd.oristudio.project+json.png": "linux/mimetypes/64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-vnd.oristudio.project+json.png": "linux/mimetypes/128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-vnd.oristudio.project+json.png": "linux/mimetypes/256.png"
        }
      }
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVERDVGRDgwOEE2NTdGMkMKUldRc2YyV0tnUDNWWFJieFZlSG9jenkxY3pzUDBESXU2SktEbEZGSzBFU3I1VmR5NEpYdWkzV0sK",
      "endpoints": [
        "https://github.com/zacharyfmarion/ori-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
